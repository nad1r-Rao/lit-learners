rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnParent(parentId) {
      return signedIn() && request.auth.uid == parentId;
    }

    // Admin identity lives in adminUsers/{uid}. Granting access is one
    // document written from the Firebase console - see
    // docs/FIREBASE_ADMIN_SETUP.md.
    function adminDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isAdminRecord() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && adminDoc().get('isActive', true) == true
        && adminDoc().role in ['superAdmin', 'contentAdmin', 'analyticsViewer'];
    }

    // Accounts promoted before adminUsers existed. Remove once migrated.
    function isLegacyAdminParent() {
      return signedIn()
        && exists(/databases/$(database)/documents/parents/$(request.auth.uid))
        && get(/databases/$(database)/documents/parents/$(request.auth.uid))
          .data.get('role', 'parent') == 'admin';
    }

    function isAdmin() {
      return isAdminRecord() || isLegacyAdminParent();
    }

    function hasAdminRole(roles) {
      return isAdminRecord() && adminDoc().role in roles;
    }

    // Authoring content and media. Analytics viewers are excluded.
    function canManageContent() {
      return hasAdminRole(['superAdmin', 'contentAdmin']) || isLegacyAdminParent();
    }

    // The parent account list carries parent emails, so it is super-admin only.
    function canReadParentAccounts() {
      return hasAdminRole(['superAdmin']) || isLegacyAdminParent();
    }

    function keepsRoleUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role']);
    }

    function ownsChildProfile(childId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/parents/$(request.auth.uid)/childProfiles/$(childId)
        );
    }

    match /adminUsers/{adminId} {
      // The app reads its own record to resolve the signed-in admin's role.
      // Rule-internal get() bypasses rules, but the client read does not.
      allow read: if signedIn() && request.auth.uid == adminId;

      // Never writable from a client, or an admin could promote themselves and
      // anyone who compromised an admin session could mint more admins. Grant
      // access from the Firebase console or a trusted backend only.
      allow write: if false;
    }

    match /parents/{parentId} {
      allow create: if isOwnParent(parentId)
        && request.resource.data.role == 'parent';
      // Admins read parent documents for the monitoring-only account list.
      // They can never write them.
      allow read: if isOwnParent(parentId) || canReadParentAccounts();
      allow update: if isOwnParent(parentId) && keepsRoleUnchanged();
      allow delete: if false;

      match /childProfiles/{childId} {
        allow read: if isOwnParent(parentId) || isAdmin();
        allow write: if isOwnParent(parentId);
      }

      match /learningReminders/{reminderId} {
        allow read, write: if isOwnParent(parentId);
      }

      match /notificationDeliveries/{deliveryId} {
        allow read, write: if isOwnParent(parentId);
      }
    }

    match /childProgress/{childId}/levelProgress/{levelId} {
      allow read: if ownsChildProfile(childId) || isAdmin();
      allow write: if ownsChildProfile(childId);
    }

    // Collection-group reads for the admin statistics screen.
    //
    // Firestore evaluates collection-group queries against these wildcard
    // matches rather than the nested paths above, so the admin aggregation
    // queries need them declared explicitly. Read-only, admin-only.
    match /{path=**}/childProfiles/{childId} {
      allow read: if isAdmin();
    }

    match /{path=**}/levelProgress/{levelId} {
      allow read: if isAdmin();
    }

    match /learningModules/{moduleId} {
      allow read: if signedIn()
        && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if canManageContent();
    }

    match /learningLevels/{levelId} {
      allow read: if signedIn()
        && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if canManageContent();
    }

    match /koalaGuideMessages/{messageId} {
      allow read: if signedIn()
        && (resource.data.isPublished == true || isAdmin());
      allow create, update, delete: if canManageContent();
    }

    match /mediaAssets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageContent();
    }

    match /leaderboards/{stageId}/entries/{childId} {
      allow read: if signedIn();
      allow create, update: if ownsChildProfile(childId)
        && request.resource.data.parentId == request.auth.uid;
      // `resource` is null when the document does not exist. Reading
      // resource.data without that guard errors out and denies the request,
      // which used to fail every leaderboard refresh.
      allow delete: if ownsChildProfile(childId)
        && (resource == null || resource.data.parentId == request.auth.uid);
    }
  }
}
